# Testing-mode profile — safe to commit, contains no secrets.
#
# Loaded ONLY in testing/preview runs (NODE_ENV=development or
# TG_MINIAPP_MODE=preview). In production, only .env is loaded and
# this file is ignored entirely.
#
# DEV_AUTH=1 lets anyone open the app in a plain browser as
# ?devUserId=<any number> — no Telegram required. Never use in production.
#
# Precedence (highest wins): real environment → .env.dev → .env
DEV_AUTH=1
ALLOWED_USER_IDS=*
