# Telegram bot token — required. Get one from @BotFather.
BOT_TOKEN=

# Comma-separated Telegram user ids allowed in. Cloud env: use freebuff-env set.
# Empty or * = anyone with valid initData (recommended to set your own id).
ALLOWED_USER_IDS=

# Secret used to sign session tokens. If empty, BOT_TOKEN is reused.
SESSION_SECRET=

# Port the server listens on (default 3000, override for Freebuff preview).
PORT=3000

# Session lifetime in seconds (default 12h).
SESSION_TTL_SECONDS=43200

# Set to 1 to allow ?devUserId=123 testing outside Telegram (dev only!).
DEV_AUTH=

# ── Production compose (docker-compose.yml + Caddy) ─────────────────────────
# Domain with a DNS A record pointing at this server.
DOMAIN=
# Email for Let's Encrypt registration (certificate auto-renewal is handled
# by Caddy; certs persist in the caddy_data volume).
ACME_EMAIL=
# Public HTTPS port (custom ports are fine, e.g. 8443) and the HTTP port
# required for the ACME HTTP-01 challenge.
HTTPS_PORT=443
HTTP_PORT=80
